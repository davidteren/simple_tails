<%= form_with(model: post) do |form| %>
  <p>
    <%= form.label :title %>
    <%= form.text_field :title, aria: { invalid: post.errors[:title].any? } %>
    <% post.errors[:title].each do |message| %>
      <span class="field-error"><%= message %></span>
    <% end %>
  </p>

  <p>
    <%= form.label :content %>
    <%= form.text_area :content, rows: 8, aria: { invalid: post.errors[:content].any? } %>
    <% post.errors[:content].each do |message| %>
      <span class="field-error"><%= message %></span>
    <% end %>
  </p>

  <p>
    <%= form.label :date %>
    <%= form.datetime_field :date, aria: { invalid: post.errors[:date].any? } %>
    <% post.errors[:date].each do |message| %>
      <span class="field-error"><%= message %></span>
    <% end %>
  </p>

  <p>
    <%= form.submit post.persisted? ? "Save changes" : "Create post" %>
  </p>
<% end %>
